# ============================================================
# Quartel Digital — VPS KVM1
# Template de variáveis de ambiente
#
# COMO USAR:
#   cp .env.example .env
#   nano .env        ← preencher valores reais
#   chmod 600 .env   ← restringir leitura
#
# NUNCA versionar o .env com valores reais.
# Este arquivo (.env.example) pode ser versionado.
# ============================================================

# ----------------------------------------------------------
# n8n — URL pública
# Usada internamente pelo n8n para montar URLs dos webhooks.
# Deve ser exatamente o domínio público sem trailing slash.
# ----------------------------------------------------------
N8N_WEBHOOK_URL=https://n8n.recrutapadrao.com.br

# ----------------------------------------------------------
# n8n — Chave de encriptação de credentials
# GERAR COM: openssl rand -hex 32
# ATENÇÃO: Perder esta chave = perder todas as credentials
# salvas no n8n. Guardar em local seguro (ex: 1Password).
# ----------------------------------------------------------
N8N_ENCRYPTION_KEY=GERAR_COM_openssl_rand_hex_32

# ----------------------------------------------------------
# Supabase
# ----------------------------------------------------------
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...SEU_SERVICE_ROLE_KEY

# ----------------------------------------------------------
# Stripe — Webhook Signing Secret
# Obter em: dashboard.stripe.com → Webhooks → endpoint → Signing secret
# ----------------------------------------------------------
STRIPE_WEBHOOK_SECRET=whsec_...SEU_SIGNING_SECRET

# ----------------------------------------------------------
# Quartel Digital — HMAC interno
# ----------------------------------------------------------
QD_HMAC_SECRET=SEU_HMAC_SECRET_INTERNO

# ----------------------------------------------------------
# Cloudflare Tunnel Token
# Obter em: dash.cloudflare.com → Zero Trust → Networks → Tunnels
# → Criar/selecionar tunnel → Install connector → Docker → copiar token
# ----------------------------------------------------------
CLOUDFLARED_TUNNEL_TOKEN=eyJhIjoiSEVVX1RPS0VO...

# ----------------------------------------------------------
# n8n — Configurações internas (não alterar sem necessidade)
# ----------------------------------------------------------
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
NODE_FUNCTION_ALLOW_BUILTIN=crypto

# ----------------------------------------------------------
# n8n — Pruning de execuções (mantém SQLite leve no KVM1)
# ----------------------------------------------------------
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_PROGRESS=false
